{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "...",
        "curl -fsSL https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64 -o /usr/local/bin/tailwindcss",
        "chmod +x /usr/local/bin/tailwindcss"
      ]
    },
    "tailwind": {
      "inputs": [
        {"step": "install"},
        {"local": true, "include": ["djangoapp/static", "djangoapp/templates"]}
      ],
      "commands": [
        "tailwindcss -i ./djangoapp/static/css/input.css -o ./djangoapp/static/css/output.css --minify"
      ],
      "deployOutputs": [{"include": ["djangoapp/static/css/output.css"]}]
    }
  }
}
